# Runs with bundled historical CSV and local SOP files; no API keys required.
DATA_BACKEND=demo
RAG_BACKEND=local
AGENT_LLM=DEMO
# For conversational tool calling: OPENAI, OLLAMA, or DEEPSEEK
LLM_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Set a long random password to enable the local audit viewer.
AUDIT_VIEW_PASSWORD=
# For DATA_BACKEND=mssql, provision a restricted account using the SQL script.
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_DATABASE=master
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_CERTIFICATE=no
# Optional RAG_BACKEND=pinecone; install requirements-vector.txt first.
PINECONE_API_KEY=
Embeddings_model=OPENAI
Local_Embedding_Model=BAAI/bge-m3
